# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Higgsfield Remote MCP Endpoint
HIGGSFIELD_MCP_URL="https://mcp.higgsfield.ai/mcp"

# Force Channel Join / Subscribe (To increase followers)
# Set your channel username (e.g. @earnifyXAutomation) or numeric channel ID (e.g. -100xxxxxxxxxx)
# Note: The Bot must be added as an Administrator in this channel!
FORCE_CHANNEL_ID="@earnifyXAutomation"
FORCE_CHANNEL_LINK="https://t.me/earnifyXAutomation"

# Allowed Telegram User IDs (Optional: leave empty for public access)
ALLOWED_USERS=""

# Default Video Generation Settings
DEFAULT_VIDEO_MODEL="seedance_2_5"
DEFAULT_ASPECT_RATIO="16:9"
